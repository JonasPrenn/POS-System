# Nach .env kopieren; die Kopie bleibt lokal (steht in .gitignore).

# Hostname, unter dem Caddy erreichbar ist — braucht einen DNS-Eintrag auf den Server.
DOMAIN=deckel.example.at

# Passwort der PostgreSQL-Datenbank.
DB_PASSWORD=bitte-ersetzen

# Berechtigt zum Erzeugen von Kopplungscodes und Sperren von Geraeten.
# Mindestens 16 Zeichen, z. B.:  openssl rand -hex 24
PAIRING_ADMIN_TOKEN=bitte-ersetzen
