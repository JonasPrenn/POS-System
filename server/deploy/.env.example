# install.sh legt die .env an; diese Datei zeigt, was darin steht. Die .env bleibt lokal
# (steht in .gitignore).

# Hostname, unter dem Caddy erreichbar ist — braucht einen DNS-Eintrag auf den Server.
DOMAIN=deckel.example.at

# Passwort der PostgreSQL-Datenbank.
DB_PASSWORD=bitte-ersetzen

# Berechtigt zum Erzeugen von Kopplungscodes und Sperren von Geraeten, und zur
# Ersteinrichtung der Verwaltung. Mindestens 16 Zeichen, z. B.:  openssl rand -hex 24
PAIRING_ADMIN_TOKEN=bitte-ersetzen

# Zeitzone der Verbindung: bestimmt „heute“ und die Monatsgrenzen in der Verwaltung.
VEREIN_ZONE=Europe/Vienna

