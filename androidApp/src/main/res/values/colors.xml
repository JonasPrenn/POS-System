<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Only what the platform needs before Compose takes over. Everything the app
      actually draws lives in ui/theme/Color.kt.

      These two match `background` in the Compose light and dark schemes, so the window
      that shows during launch is already the right colour.
    -->
    <color name="window_background">#F4F3EF</color>
    <color name="window_background_dark">#121211</color>
</resources>
